{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": false,
    "incremental": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vitest/globals"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src", "tests", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "next.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
