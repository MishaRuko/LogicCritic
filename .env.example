APP_ENV=development
APP_BASE_URL=http://localhost
APP_BIND=0.0.0.0
APP_PORT=80
CADDYFILE=./infra/Caddyfile
POSTGRES_DB=logiccritic
POSTGRES_USER=logiccritic
POSTGRES_PASSWORD=change-me
POSTGRES_URL=postgresql://logiccritic:change-me@postgres:5432/logiccritic
REDIS_URL=redis://redis:6379/0
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
AMASS_API_KEY=
JWT_SECRET=change-me-before-deploying
UPLOAD_DIR=/data/uploads
AGENT_MODEL=claude-sonnet-5-5
AGENT_JUDGE_MODEL=claude-sonnet-5
AGENT_MAX_TURNS=30
AGENT_MAX_WEB_SEARCHES=10
AGENT_TURN_MAX_TOKENS=16000
AGENT_USER_AGENT=LogicCritic-ResearchAgent/1.0
EVAL_GENERATOR_MODEL=claude-sonnet-5-5
EVAL_JUDGE_MODEL=claude-opus-5-5
EVAL_MAX_TURNS=6
EVAL_GUARDED_MAX_TURNS=12
EVAL_MAX_WEB_SEARCHES=0
EVAL_MAX_COST_USD=50
